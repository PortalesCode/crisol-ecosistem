# Crisol-Eco — .gitignore refinado
#
# Ignoramos solo lo transitorio. .opencode/ viaja con el proyecto.

# Dependencias
node_modules/
.opencode/node_modules/

# Memoria transitoria (preferencias de usuario, snapshots de stack)
workspec/Memoria/preferences-user/
workspec/Memoria/stack/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.env
.venv/

# Planes (los genera el plugin — solo trackeamos los .gitkeep)
workspec/plans/active/*
!workspec/plans/active/.gitkeep
workspec/plans/old/*
!workspec/plans/old/.gitkeep
